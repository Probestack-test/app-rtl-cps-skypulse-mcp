# Environment for SkyPulse MCP.
# Copy the names below into your environment (or your secret manager). Never commit real values.

PORT=8080

# The API the tools call. Empty means the server URL from the specification.
UPSTREAM_BASE_URL=https://api.open-meteo.com/v1

# --- OAuth 2.0 (client credentials): required ---
# Callers get an access token from POST /oauth/token with this client id and secret.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
# Signs the access tokens; at least 32 random characters, e.g. `openssl rand -base64 48`.
MCP_OAUTH_SIGNING_KEY=
# Optional
# MCP_OAUTH_TOKEN_TTL_SECONDS=3600
# MCP_OAUTH_ISSUER=skypulse-mcp
# MCP_OAUTH_AUDIENCE=skypulse-mcp

# --- Optional tuning ---
# UPSTREAM_TIMEOUT_MS=10000
# UPSTREAM_RETRY_ATTEMPTS=2
