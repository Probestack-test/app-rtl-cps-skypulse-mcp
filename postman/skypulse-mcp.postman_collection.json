  "event" : [ {
    "script" : {
      "type" : "text/javascript",
      "exec" : [ "// Gets an access token from the server's token endpoint when there is none yet or it is about to expire.", "const expiresAt = Number(pm.collectionVariables.get('accessTokenExpiresAt') || 0);", "if (!pm.collectionVariables.get('accessToken') || Date.now() >= expiresAt) {", "  pm.sendRequest({", "    url: pm.variables.replaceIn('{{baseUrl}}/oauth/token'),", "    method: 'POST',", "    header: { 'Content-Type': 'application/x-www-form-urlencoded' },", "    body: {", "      mode: 'urlencoded',", "      urlencoded: [", "        { key: 'grant_type', value: 'client_credentials' },", "        { key: 'client_id', value: pm.variables.replaceIn('{{clientId}}') },", "        { key: 'client_secret', value: pm.variables.replaceIn('{{clientSecret}}') }", "      ]", "    }", "  }, (error, response) => {", "    if (error || response.code !== 200) {", "      console.error('Could not get an access token', error || response.text());", "    } else {", "      const token = response.json();", "      pm.collectionVariables.set('accessToken', token.access_token);", "      pm.collectionVariables.set('accessTokenExpiresAt', String(Date.now() + (token.expires_in - 30) * 1000));", "    }", "  });", "}" ]
    },
    "listen" : "prerequest"
  } ],
